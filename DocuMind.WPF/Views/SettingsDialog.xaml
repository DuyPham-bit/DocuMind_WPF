<Window x:Class="DocuMind.WPF.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cài Đặt Nền Tảng AI (AI Providers)"
        Height="720" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinHeight="540" MinWidth="480"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Tahoma, sans-serif">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Cấu Hình Nền Tảng AI" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Đổi nhà cung cấp, thiết lập API Key được mã hóa chuẩn Windows DPAPI."
                       FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Form fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Provider Selector -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Nhà cung cấp AI (Provider)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding AvailableProviders}"
                              IsEnabled="{Binding IsEditable}"
                              SelectedItem="{Binding SelectedProvider}"
                              Height="38" FontSize="13" Padding="8,4"
                              Background="#FFFFFF" BorderBrush="#CBD5E1"/>
                </StackPanel>

                <!-- API Key -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="API Key (Mã khóa kết nối)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="KeyBox" PasswordChanged="KeyBox_PasswordChanged" Height="36" Padding="8" IsEnabled="{Binding IsEditable}"/>
                    <Button Content="Giữ để hiện key" PreviewMouseLeftButtonDown="RevealKey_Down" PreviewMouseLeftButtonUp="RevealKey_Up" MouseLeave="RevealKey_Leave"/>
                    <TextBlock x:Name="RevealedKey" Visibility="Collapsed" TextWrapping="Wrap"/>
                    <TextBlock Text="* Key được mã hóa bằng DPAPI CurrentUser, gắn với tài khoản Windows hiện tại."
                               FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Chat Model -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Tên Model Chat (Ví dụ: gemini-2.5-flash, gpt-4o-mini, llama-3.3-70b)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ChatModel, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource RoundedTextBox}"/>
                </StackPanel>

                <!-- Base URL -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Model embedding (độc lập với model chat)" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding EmbeddingModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}"/>
                    <CheckBox Content="Dùng provider này cho embedding/RAG" IsChecked="{Binding UseForEmbedding}" Margin="0,6"/>
                    <TextBlock Text="Lưu provider chat khác vẫn giữ provider embedding đã chọn. Đổi profile embedding cần re-index." TextWrapping="Wrap" FontSize="11"/>
                    <Button Content="Kiểm tra embedding (không lưu)" Command="{Binding TestEmbeddingCommand}"/>
                    <Button Content="Hủy kiểm tra" Command="{Binding CancelCommand}"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Base URL tùy chỉnh (Dành cho Groq/Ollama hoặc Proxy)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource RoundedTextBox}"/>
                </StackPanel>

                <!-- Temperature -->
                <StackPanel Margin="0,0,0,6">
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Độ sáng tạo (Temperature): " FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Temperature, StringFormat={}{0:F2}}" FontWeight="Bold" Foreground="#2563EB"/>
                    </DockPanel>
                    <Slider Minimum="0.0" Maximum="1.0" Value="{Binding Temperature}" SmallChange="0.05" LargeChange="0.1"
                            TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Message -->
        <Border Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6"
                Padding="12,8" Margin="0,16,0,16">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap"/>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="⚡ Kiểm tra kết nối"
                    Command="{Binding TestConnectionCommand}"
                    Style="{StaticResource SecondaryButton}"/>

            <Button Grid.Column="2" Content="💾 Lưu cấu hình"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButton}"/>
        </Grid>
    </Grid>
</Window>
