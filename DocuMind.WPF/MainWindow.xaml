<Window x:Class="DocuMind.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DocuMind – Trợ Lý Quản Lý Tri Thức &amp; Hỏi Đáp Tài Liệu Thông Minh" 
        Height="760" Width="1160"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Tahoma, sans-serif">

    <Window.Resources>
        <!-- Converter for visibility boolean -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- User Message Bubble Style -->
        <Style x:Key="UserBubbleStyle" TargetType="Border">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="CornerRadius" Value="14,14,2,14"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="40,4,8,4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MaxWidth" Value="680"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12" Color="#1E3A8A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Assistant Message Bubble Style -->
        <Style x:Key="AiBubbleStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14,14,14,2"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="8,4,40,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth" Value="720"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button Styles -->
        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TemplateChipBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E40AF"/>
            <Setter Property="BorderBrush" Value="#BFDBFE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar -->
            <ColumnDefinition Width="290"/>
            <!-- Right Main Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- =================== LEFT SIDEBAR =================== -->
        <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid Margin="18,20,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- App Brand -->
                    <RowDefinition Height="Auto"/> <!-- Workspace Header & Selector -->
                    <RowDefinition Height="*"/>    <!-- Documents List -->
                    <RowDefinition Height="Auto"/> <!-- Provider Info & Settings -->
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#2563EB" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                            <TextBlock Text="🧠" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="DocuMind" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="AI Knowledge &amp; RAG" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Workspace Section -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <TextBlock Text="KHÔNG GIAN LÀM VIỆC" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Workspaces}" 
                              SelectedItem="{Binding SelectedWorkspace}"
                              DisplayMemberPath="Name"
                              Height="36" FontSize="13" Background="#FFFFFF" BorderBrush="#CBD5E1"/>

                    <!-- Action Upload File -->
                    <Button Content="➕ Nạp tài liệu (PDF, TXT, MD)" 
                            Command="{Binding UploadDocumentCommand}"
                            Style="{StaticResource PrimaryActionBtn}"
                            Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Documents List -->
                <Grid Grid.Row="2" Margin="0,4,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="TÀI LIỆU TRONG KHO" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding UploadedFiles.Count, StringFormat={}({0})}" 
                                   FontSize="11" Foreground="#2563EB" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4">
                                <ItemsControl ItemsSource="{Binding UploadedFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" 
                                                    CornerRadius="6" Margin="4,2" Padding="8,6">
                                                <DockPanel>
                                                    <TextBlock Text="📄" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <Button Content="✕" 
                                                            Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Width="20" Height="20" Background="Transparent" BorderThickness="0" 
                                                            Foreground="#EF4444" FontWeight="Bold" Cursor="Hand" DockPanel.Dock="Right"
                                                            ToolTip="Xóa tài liệu này khỏi kho"/>
                                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="#1E293B" 
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Bottom AI Provider & Settings -->
                <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Nền tảng AI:" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock Text="🟢 Đang chạy" FontSize="11" Foreground="#16A34A" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock Text="{Binding ActiveProviderInfo}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                        
                        <Button Content="⚙️ Cài đặt API Key &amp; Nền tảng" 
                                Command="{Binding OpenSettingsCommand}"
                                Style="{StaticResource GhostBtn}"
                                Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- =================== RIGHT MAIN CHAT AREA =================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Bar Header -->
                <RowDefinition Height="*"/>    <!-- Chat Conversation -->
                <RowDefinition Height="Auto"/> <!-- Templates & Prompt Input -->
            </Grid.RowDefinitions>

            <!-- Top Bar Header -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
                <DockPanel LastChildFill="False">
                    <!-- Left info -->
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding SelectedWorkspace.Name, FallbackValue='Không gian làm việc'}" 
                                   FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="{Binding SystemPrompt}" 
                                   FontSize="11" Foreground="#64748B" MaxWidth="500" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Right Controls -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- RAG Mode Toggle -->
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="20" Padding="6,2" Margin="0,0,12,0">
                            <CheckBox IsChecked="{Binding UseRagMode}" VerticalAlignment="Center" Margin="4,0" Cursor="Hand">
                                <CheckBox.Content>
                                    <TextBlock Text="🔍 Tra cứu RAG trên tài liệu" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                                </CheckBox.Content>
                            </CheckBox>
                        </Border>

                        <!-- Export Markdown -->
                        <Button Content="📥 Xuất Markdown" 
                                Command="{Binding ExportMarkdownCommand}"
                                Style="{StaticResource GhostBtn}"
                                Margin="0,0,8,0"/>

                        <!-- Clear Chat -->
                        <Button Content="🗑️ Xóa chat" 
                                Command="{Binding ClearChatCommand}"
                                Style="{StaticResource GhostBtn}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Chat Messages List -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ChatMessages}" Margin="16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <!-- USER BUBBLE -->
                                    <Border Style="{StaticResource UserBubbleStyle}" 
                                            Visibility="{Binding IsUser, Converter={StaticResource BoolToVisConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Content}" FontSize="13" Foreground="#FFFFFF" 
                                                       TextWrapping="Wrap" LineHeight="19"/>
                                            <TextBlock Text="{Binding FormattedTime}" FontSize="10" Foreground="#BFDBFE" 
                                                       HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- AI ASSISTANT BUBBLE -->
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource AiBubbleStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="✨ DocuMind AI" FontSize="12" FontWeight="Bold" Foreground="#2563EB"/>
                                                <TextBlock Text="{Binding FormattedTime}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                            </DockPanel>

                                            <!-- Content Text -->
                                            <TextBlock Text="{Binding Content}" FontSize="13" Foreground="#0F172A" 
                                                       TextWrapping="Wrap" LineHeight="20"/>

                                            <!-- Sources / Citations Box -->
                                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" 
                                                    Margin="0,10,0,0" Padding="10,8"
                                                    Visibility="{Binding HasSources, Converter={StaticResource BoolToVisConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="📚 Nguồn trích dẫn từ tài liệu:" FontSize="11" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,4"/>
                                                    <ItemsControl ItemsSource="{Binding Sources}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#FFFFFF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="4" Margin="0,2" Padding="6,4">
                                                                    <StackPanel>
                                                                        <DockPanel>
                                                                            <TextBlock Text="{Binding FileName, StringFormat='📄 {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                                                                            <TextBlock Text="{Binding PageNumber, StringFormat='Trang {0}'}" FontSize="11" Foreground="#475569" Margin="6,0,0,0"/>
                                                                            <TextBlock Text="{Binding Score, StringFormat='(Độ khớp {0:P0})'}" FontSize="10" Foreground="#16A34A" HorizontalAlignment="Right"/>
                                                                        </DockPanel>
                                                                        <TextBlock Text="{Binding Content}" FontSize="11" Foreground="#64748B" FontStyle="Italic" TextTrimming="CharacterEllipsis" MaxHeight="32" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Loading Overlay -->
                <Border Background="#66FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" 
                        VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
                        CornerRadius="20" Padding="16,8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="20" Height="20" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding BusyStatus}" FontSize="12" FontWeight="SemiBold" Foreground="#1E40AF"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Prompt Templates & Input Box -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12,20,16">
                <StackPanel>
                    <!-- Quick Prompt Templates Bar -->
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Gợi ý câu hỏi nhanh:" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ItemsControl ItemsSource="{Binding PromptTemplates}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Title}" 
                                            ToolTip="{Binding Description}"
                                            Command="{Binding DataContext.ApplyTemplateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TemplateChipBtn}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <!-- Text Input Box -->
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtInput"
                                     Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     AcceptsReturn="True"
                                     MaxHeight="90" 
                                     MinHeight="40"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     Padding="4,8"
                                     KeyDown="TxtInput_KeyDown"/>

                            <Button Grid.Column="1" 
                                    Content="Gửi ➤" 
                                    Command="{Binding SendMessageCommand}"
                                    Style="{StaticResource PrimaryActionBtn}"
                                    Width="80" Height="36"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
