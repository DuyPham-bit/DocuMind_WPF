<Window x:Class="DocuMind.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DocuMind.WPF.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DocuMind — Document Intelligence"
        Height="780" Width="1220" MinHeight="660" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="#F6FAFF" FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <SolidColorBrush x:Key="InkBrush" Color="#12304A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#66819B"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3478F6"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#1D5ED8"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D7E7F5"/>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#42627B"/><Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="SurfaceCard" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Padding" Value="11,8"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="#F9FCFF"/><Setter Property="BorderBrush" Value="#C9DDEE"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#5B9CFF"/><Setter TargetName="Border" Property="Background" Value="White"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="15,0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentDarkBrush}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="12,0"/><Setter Property="Foreground" Value="#28516F"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#F0F7FF"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#A9CDF5"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#E3F0FF"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.48"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Foreground" Value="#2162B6"/>
            <Setter Property="Background" Value="#F1F7FF"/><Setter Property="BorderBrush" Value="#CDE2FA"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ChipBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChipBorder" Property="Background" Value="#DDEEFF"/><Setter TargetName="ChipBorder" Property="BorderBrush" Value="#78ADF1"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="RagToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="ToggleBorder" Padding="10,6" Background="#EEF6FF" BorderBrush="#CFE2F7" BorderThickness="1" CornerRadius="17">
                    <StackPanel Orientation="Horizontal"><Border x:Name="Track" Width="30" Height="16" Background="#AFC6DB" CornerRadius="8" Margin="0,0,8,0"><Ellipse x:Name="Knob" Width="12" Height="12" Fill="White" HorizontalAlignment="Left" Margin="2"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#3478F6"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="#E0F0FF"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="UserBubble" TargetType="Border"><Setter Property="Background" Value="#3478F6"/><Setter Property="CornerRadius" Value="15,15,4,15"/><Setter Property="Padding" Value="14,11"/><Setter Property="Margin" Value="120,5,8,5"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="MaxWidth" Value="670"/></Style>
        <Style x:Key="AssistantBubble" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="15,15,15,4"/><Setter Property="Padding" Value="15,12"/><Setter Property="Margin" Value="8,5,120,5"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="MaxWidth" Value="760"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="318"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#EFF7FF" BorderBrush="#D6E6F5" BorderThickness="0,0,1,0">
            <Grid Margin="22,24,18,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal"><Border Width="42" Height="42" Background="#3478F6" CornerRadius="13" Margin="0,0,12,0"><TextBlock Text="✦" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="DocuMind" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/><TextBlock Text="DOCUMENT INTELLIGENCE" Style="{StaticResource SectionLabel}" Margin="1,2,0,0"/></StackPanel></StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="WORKSPACE" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}" DisplayMemberPath="Name" Height="40" Padding="10,0" FontSize="12" Foreground="{StaticResource InkBrush}" Background="White" BorderBrush="#C9DDEE"/>
                    <Expander Header="Workspace settings" Foreground="#42627B" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,0">
                        <StackPanel Margin="0,9,0,2"><TextBlock Text="NAME" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding WorkspaceName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/><TextBlock Text="SYSTEM INSTRUCTION" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/><TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="84" VerticalScrollBarVisibility="Auto"/><StackPanel Orientation="Horizontal" Margin="0,10,0,2"><Button Content="New" Command="{Binding CreateWorkspaceCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/><Button Content="Save" Command="{Binding SaveWorkspaceCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/><Button Content="Delete" Command="{Binding DeleteWorkspaceCommand}" Style="{StaticResource SecondaryButton}"/></StackPanel></StackPanel>
                    </Expander>
                    <Button Content="＋  Upload documents" Command="{Binding UploadDocumentCommand}" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"/>
                </StackPanel>
                <Grid Grid.Row="2" Margin="0,24,0,20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,9"><TextBlock Text="DOCUMENTS" Style="{StaticResource SectionLabel}"/><Border DockPanel.Dock="Right" Background="#DDEEFF" CornerRadius="10" Padding="7,2"><TextBlock Text="{Binding UploadedFiles.Count, StringFormat={}{0}}" FontSize="10" FontWeight="Bold" Foreground="#1D5ED8"/></Border></DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Background="#FFFFFF"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5"><ItemsControl ItemsSource="{Binding UploadedFiles}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F7FBFF" BorderBrush="#E0ECF6" BorderThickness="1" CornerRadius="9" Margin="2,3" Padding="9,8"><DockPanel LastChildFill="True"><Button Content="×" Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Remove document" DockPanel.Dock="Right" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#6E8BA4" FontSize="17" Cursor="Hand"/><Border Width="25" Height="25" Background="#DCEEFF" CornerRadius="7" Margin="0,0,8,0" DockPanel.Dock="Left"><TextBlock Text="⌁" Foreground="#3478F6" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Label}" ToolTip="{Binding SourcePath}" FontSize="11" FontWeight="SemiBold" Foreground="#24455F" TextTrimming="CharacterEllipsis"/><TextBlock Text="Indexed document" FontSize="9" Foreground="#7B95AA" Margin="0,2,0,0"/></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border>
                </Grid>
                <Border Grid.Row="3" Style="{StaticResource SurfaceCard}" Padding="13"><StackPanel><DockPanel Margin="0,0,0,5"><TextBlock Text="AI PROVIDER" Style="{StaticResource SectionLabel}"/><TextBlock Text="LOCAL" DockPanel.Dock="Right" FontSize="9" FontWeight="Bold" Foreground="#4384C8"/></DockPanel><TextBlock Text="{Binding ActiveProviderInfo}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,10"/><Button Content="Manage providers" Command="{Binding OpenSettingsCommand}" Style="{StaticResource SecondaryButton}"/></StackPanel></Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#F8FBFF">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="#DCE9F4" BorderThickness="0,0,0,1" Padding="28,18">
                <DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Left" MaxWidth="380"><TextBlock Text="KNOWLEDGE WORKSPACE" Style="{StaticResource SectionLabel}"/><TextBlock Text="{Binding SelectedWorkspace.Name, FallbackValue='Workspace'}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox IsChecked="{Binding UseRagMode}" Style="{StaticResource RagToggle}" Margin="0,0,9,0"><TextBlock Text="Search documents" FontSize="11" FontWeight="SemiBold" Foreground="#24506F"/></CheckBox><Button Content="Export" Command="{Binding ExportMarkdownCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="New chat" Command="{Binding ClearChatCommand}" Style="{StaticResource SecondaryButton}"/></StackPanel></DockPanel>
            </Border>
            <Grid Grid.Row="1">
                <Border Width="440" Padding="34,30" Background="White" BorderBrush="#D7E7F5" BorderThickness="1" CornerRadius="18"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsChatEmpty, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="16" Background="#E4F1FF" HorizontalAlignment="Center" Margin="0,0,0,15"><TextBlock Text="✦" FontSize="23" Foreground="#3478F6" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="Ready when you are" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Upload a document, keep Search documents enabled, and ask DocuMind a question about your files." FontSize="12" Foreground="#66819B" TextAlignment="Center" TextWrapping="Wrap" LineHeight="18" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>
                <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,22"><ItemsControl ItemsSource="{Binding ChatMessages}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Border Style="{StaticResource UserBubble}" Visibility="{Binding IsUser, Converter={StaticResource BoolToVisConverter}}"><StackPanel><DockPanel Margin="0,0,0,5"><TextBlock Text="YOU" FontSize="9" FontWeight="Bold" Foreground="#CFE3FF"/><TextBlock Text="{Binding FormattedTime}" DockPanel.Dock="Right" FontSize="9" Foreground="#CFE3FF"/></DockPanel><TextBlock Text="{Binding Content}" FontSize="13" Foreground="White" TextWrapping="Wrap" LineHeight="20"/></StackPanel></Border><Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource AssistantBubble}"><Style.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><DockPanel Margin="0,0,0,9"><StackPanel Orientation="Horizontal"><Border Width="25" Height="25" Background="#DCEEFF" CornerRadius="8" Margin="0,0,8,0"><TextBlock Text="✦" Foreground="#3478F6" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="DocuMind" FontSize="11" FontWeight="Bold" Foreground="#215478"/><TextBlock Text="AI ASSISTANT" FontSize="8" FontWeight="SemiBold" Foreground="#83A0B5"/></StackPanel></StackPanel><TextBlock Text="{Binding FormattedTime}" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="9" Foreground="#87A0B3"/></DockPanel><controls:MarkdownView Markdown="{Binding Content}"/><Border Background="#F1F8FF" BorderBrush="#D5E8FA" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,12,0,0" Visibility="{Binding HasSources, Converter={StaticResource BoolToVisConverter}}"><StackPanel><TextBlock Text="SOURCES" Style="{StaticResource SectionLabel}" Foreground="#3478C9" Margin="0,0,0,5"/><ItemsControl ItemsSource="{Binding Sources}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#E0EDF9" BorderThickness="1" CornerRadius="7" Padding="8" Margin="0,3"><StackPanel><DockPanel><TextBlock Text="{Binding FileName}" FontSize="10" FontWeight="SemiBold" Foreground="#24619A" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding PageNumber, StringFormat=Page {0}}" DockPanel.Dock="Right" FontSize="10" Foreground="#607F96"/></DockPanel><TextBlock Text="{Binding Content}" FontSize="10" Foreground="#607F96" TextTrimming="CharacterEllipsis" MaxHeight="32" Margin="0,3,0,4"/><Button Content="Open source" Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Height="28" Padding="9,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel></Border></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                <Border Background="#EAF5FF" BorderBrush="#BFDDF7" BorderThickness="1" CornerRadius="14" Padding="14,9" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ProgressBar IsIndeterminate="True" Width="22" Height="6" Margin="0,0,10,0"/><TextBlock Text="{Binding BusyStatus}" FontSize="11" FontWeight="SemiBold" Foreground="#28648F"/><Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Height="28" Margin="10,0,0,0"/></StackPanel></Border>
            </Grid>
            <Border Grid.Row="2" Background="White" BorderBrush="#DCE9F4" BorderThickness="0,1,0,0" Padding="28,16,28,20"><StackPanel><DockPanel Margin="0,0,0,10"><TextBlock Text="QUICK START" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/><ItemsControl ItemsSource="{Binding PromptTemplates}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" ToolTip="{Binding Description}" Command="{Binding DataContext.ApplyTemplateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource ChipButton}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel><Border Background="#F6FAFF" BorderBrush="#BDD7EF" BorderThickness="1" CornerRadius="13" Padding="7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TxtInput" Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ask about your uploaded documents" FontSize="13" Foreground="{StaticResource InkBrush}" Background="Transparent" BorderThickness="0" Padding="8,7" AcceptsReturn="True" MaxHeight="90" MinHeight="38" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" KeyDown="TxtInput_KeyDown"/><Button Grid.Column="1" Content="Send  →" Command="{Binding SendMessageCommand}" Style="{StaticResource PrimaryButton}" Width="90" Margin="8,0,0,0" VerticalAlignment="Bottom"/></Grid></Border><TextBlock Text="Use Shift + Enter for a new line" FontSize="10" Foreground="#86A0B3" Margin="4,7,0,0"/></StackPanel></Border>
        </Grid>
    </Grid>
</Window>
