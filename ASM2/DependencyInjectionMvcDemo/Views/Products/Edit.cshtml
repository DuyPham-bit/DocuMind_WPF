@model DependencyInjectionMvcDemo.Models.Product

@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<section class="page-card">
    <div class="page-header">
        <div>
            <h1 class="page-title">Sửa sản phẩm #@Model.Id</h1>
            <p class="page-subtitle">Cập nhật thông tin qua <code class="mono">IProductService.Update</code>.</p>
        </div>
        <a asp-action="Index" class="btn-app btn-app-outline">Quay lại danh sách</a>
    </div>

    <form asp-action="Edit" method="post" class="form-grid">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

        <partial name="_ProductFormFields" model="Model" />

        <div class="d-flex gap-2">
            <button type="submit" class="btn-app btn-app-primary">Cập nhật</button>
            <a asp-action="Index" class="btn-app btn-app-outline">Hủy</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
