@model ProductManagerMvc.Models.Product

@{
    ViewData["Title"] = "Xác nhận xóa sản phẩm";
}

<section class="page-card">
    <div class="page-header">
        <div>
            <h1 class="page-title">Xác nhận xóa sản phẩm</h1>
            <p class="page-subtitle">Hành động này sẽ xóa vĩnh viễn bản ghi khỏi bảng Products trong SQL Server.</p>
        </div>
        <a asp-action="Index" class="btn-app btn-app-outline">Quay lại danh sách</a>
    </div>

    <div class="p-3 mb-4 border border-danger-subtle rounded-3 bg-danger-subtle text-danger-emphasis">
        Bạn có chắc chắn muốn xóa sản phẩm <strong>@Model.Name</strong> (#@Model.Id) không?
    </div>

    <dl class="row mb-4">
        <dt class="col-sm-3 text-secondary">Tên sản phẩm</dt>
        <dd class="col-sm-9 fw-bold">@Model.Name</dd>

        <dt class="col-sm-3 text-secondary">Giá bán</dt>
        <dd class="col-sm-9">@Model.Price.ToString("N0") VNĐ</dd>

        <dt class="col-sm-3 text-secondary">Tồn kho</dt>
        <dd class="col-sm-9">@Model.Stock</dd>
    </dl>

    <form asp-action="Delete" method="post" class="d-flex flex-wrap gap-2">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn-app btn-app-danger">Xác nhận xóa</button>
        <a asp-action="Index" class="btn-app btn-app-outline">Hủy bỏ</a>
    </form>
</section>
