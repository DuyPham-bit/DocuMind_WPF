<Window x:Class="DocuMind.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DocuMind.WPF.Controls"
        xmlns:loc="clr-namespace:DocuMind.WPF.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DocuMind — Document Intelligence"
        Height="800" Width="1280" MinHeight="660" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="#FAF6EE"
        Foreground="#1F1A14"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DocuMind.WPF;component/Styles/FuturisticTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

            <Style x:Key="RagToggle" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="ToggleBorder" Padding="11,6" Background="#F6ECDC" BorderBrush="#DECBAE" BorderThickness="1" CornerRadius="18">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="Track" Width="32" Height="17" Background="#C7B69B" CornerRadius="8.5" Margin="0,0,8,0">
                                        <Ellipse x:Name="Knob" Width="13" Height="13" Fill="#FFFDF9" HorizontalAlignment="Left" Margin="2"/>
                                    </Border>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="#B45309"/>
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Knob" Property="Fill" Value="White"/>
                                    <Setter TargetName="ToggleBorder" Property="Background" Value="#FFF8EC"/>
                                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#B45309"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ToggleBorder" Property="Background" Value="#EFE2CB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="UserBubble" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AiPrimaryGradient}"/>
                <Setter Property="CornerRadius" Value="16,16,4,16"/>
                <Setter Property="Padding" Value="15,12"/>
                <Setter Property="Margin" Value="100,6,8,6"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="MaxWidth" Value="680"/>
            </Style>

            <Style x:Key="AssistantBubble" TargetType="Border">
                <Setter Property="Background" Value="#FFFDF9"/>
                <Setter Property="BorderBrush" Value="#E3D7C3"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16,16,16,4"/>
                <Setter Property="Padding" Value="16,13"/>
                <Setter Property="Margin" Value="8,6,90,6"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="MaxWidth" Value="780"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="336"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Warm Beige Studio Sidebar -->
        <Border Grid.Column="0" BorderBrush="#E3D7C3" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F6EFE2" Offset="0"/>
                    <GradientStop Color="#EFE5D2" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="20,20,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="110"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="13" Margin="0,0,12,0" Background="{StaticResource AiPrimaryGradient}">
                            <Path Data="M12,2 L14.6,8.8 L21.5,11.5 L14.6,14.2 L12,21 L9.4,14.2 L2.5,11.5 L9.4,8.8 Z"
                                  Fill="White" Width="22" Height="22" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="DocuMind" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkPrimaryBrush}"/>
                                <Border Background="#FFF7E6" BorderBrush="#D9A760" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="AI STUDIO" FontSize="9" FontWeight="Bold" Foreground="#9A3412"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=BrandSubtitle}" Style="{StaticResource HudLabel}" Foreground="#7B6A56" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Workspace Selector & Controls -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=WorkspaceHeader}" Style="{StaticResource HudLabel}" Margin="0,0,0,7"/>
                    <ComboBox ItemsSource="{Binding Workspaces}"
                              SelectedItem="{Binding SelectedWorkspace}"
                              Style="{StaticResource FuturisticComboBox}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Expander Header="{Binding Source={x:Static loc:UiText.Current}, Path=WorkspaceSettingsHeader}" Foreground="#5C4E3F" FontSize="11.5" FontWeight="SemiBold" Margin="0,11,0,0">
                        <StackPanel Margin="0,9,0,2">
                            <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=WorkspaceNameLabel}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding WorkspaceName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/>
                            <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=SystemInstructionLabel}" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/>
                            <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     MinHeight="62" MaxHeight="76"
                                     VerticalScrollBarVisibility="Auto"/>
                            <WrapPanel Margin="0,10,0,2">
                                <Button Content="{Binding Source={x:Static loc:UiText.Current}, Path=NewButton}" Command="{Binding CreateWorkspaceCommand}" Style="{StaticResource SecondaryButton}" MinWidth="74" Margin="0,0,8,4"/>
                                <Button Content="{Binding Source={x:Static loc:UiText.Current}, Path=SaveButton}" Command="{Binding SaveWorkspaceCommand}" Style="{StaticResource SecondaryButton}" MinWidth="68" Margin="0,0,8,4"/>
                                <Button Content="{Binding Source={x:Static loc:UiText.Current}, Path=DeleteButton}" Command="{Binding DeleteWorkspaceCommand}" Style="{StaticResource SecondaryButton}" MinWidth="68" Margin="0,0,0,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </Expander>

                    <Button Content="{Binding Source={x:Static loc:UiText.Current}, Path=UploadDocumentsButton}" Command="{Binding UploadDocumentCommand}" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- Documents Vault -->
                <Grid Grid.Row="2" Margin="0,18,0,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Source={x:Static loc:UiText.Current}, Path=DocumentsHeader}" Style="{StaticResource HudLabel}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#F5E9D3" BorderBrush="#DECBAE" BorderThickness="1" CornerRadius="10" Padding="9,2">
                            <TextBlock Text="{Binding UploadedFiles.Count, StringFormat={}{0}}" FontSize="10.5" FontWeight="Bold" Foreground="#9A3412"/>
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource GlassCard}" Background="#FFFDF9">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6">
                            <ItemsControl ItemsSource="{Binding UploadedFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FAF5EB" BorderBrush="#E6DAC5" BorderThickness="1" CornerRadius="10" Margin="2,3" Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="28" Height="28" Background="#F3E5CE" BorderBrush="#DFC9A4" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
                                                    <Path Data="M6,2 L14,2 L18,6 L18,20 C18,21.1 17.1,22 16,22 L6,22 C4.9,22 4,21.1 4,20 L4,4 C4,2.9 4.9,2 6,2 Z"
                                                          Stroke="#9A4A18" StrokeThickness="1.5" Width="13" Height="15" Stretch="Uniform"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding SourcePath}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource InkPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="9.5" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding Source={x:Static loc:UiText.Current}, Path=DocIndexedLabel}"/>
                                                                <Setter Property="Foreground" Value="#047857"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding NeedsReindex}" Value="True">
                                                                        <Setter Property="Text" Value="{Binding Source={x:Static loc:UiText.Current}, Path=DocPendingLabel}"/>
                                                                        <Setter Property="Foreground" Value="#B45309"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="×"
                                                        Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{Binding Source={x:Static loc:UiText.Current}, Path=RemoveDocTooltip}"
                                                        Width="24" Height="24" Padding="0" Margin="6,0,0,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#7B6A56" FontSize="17" Cursor="Hand"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Provider Status Card -->
                <Border Grid.Row="3" Style="{StaticResource GlassCard}" Padding="14">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Source={x:Static loc:UiText.Current}, Path=AiProviderHeader}" Style="{StaticResource HudLabel}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#F6ECDC" BorderBrush="#DFC9A4" BorderThickness="1" CornerRadius="6" Padding="7,2">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#047857" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="DPAPI LOCAL" FontSize="9" FontWeight="Bold" Foreground="#5C4E3F"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding ActiveProviderInfo}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,10"/>
                        <Button Content="{Binding Source={x:Static loc:UiText.Current}, Path=ManageProvidersButton}" Command="{Binding OpenSettingsCommand}" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main AI Stage -->
        <Grid Grid.Column="1">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.18" GradientOrigin="0.5,0.18" RadiusX="0.85" RadiusY="0.85">
                    <GradientStop Color="#FFFDF9" Offset="0"/>
                    <GradientStop Color="#F7F1E4" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Warm Studio Header -->
            <Border Grid.Row="0" Background="#FFFDF8" BorderBrush="#E5DAC6" BorderThickness="0,0,0,1" Padding="24,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="160"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=KnowledgeWorkspaceHeader}" Style="{StaticResource HudLabel}"/>
                        <TextBlock Text="{Binding SelectedWorkspace.Name, FallbackValue='Workspace'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding Source={x:Static loc:UiText.Current}, Path=LanguageButtonLabel}"
                                Command="{Binding Source={x:Static loc:UiText.Current}, Path=ToggleLanguageCommand}"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="Switch English / Tiếng Việt"
                                Margin="0,0,8,0"/>
                        <CheckBox IsChecked="{Binding UseRagMode}" Style="{StaticResource RagToggle}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=SearchDocumentsLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource InkPrimaryBrush}"/>
                        </CheckBox>
                        <Button Content="{Binding Source={x:Static loc:UiText.Current}, Path=ExportButton}" Command="{Binding ExportMarkdownCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Content="{Binding Source={x:Static loc:UiText.Current}, Path=NewChatButton}" Command="{Binding ClearChatCommand}" Style="{StaticResource SecondaryButton}"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Conversation Viewport + Status Strip -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Empty State -->
                <Border MaxWidth="480" Margin="24" Padding="34,30"
                        Background="#FFFDF9" BorderBrush="#E3D7C3" BorderThickness="1" CornerRadius="20"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsChatEmpty, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,16" Background="{StaticResource AiPrimaryGradient}">
                            <Path Data="M12,2 L14.6,8.8 L21.5,11.5 L14.6,14.2 L12,21 L9.4,14.2 L2.5,11.5 L9.4,8.8 Z"
                                  Fill="White" Width="26" Height="26" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=EmptyTitle}" FontSize="21" FontWeight="Bold" Foreground="{StaticResource InkPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=EmptySubtitle}"
                                   FontSize="12.5" Foreground="{StaticResource InkMutedBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" LineHeight="19" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Messages Feed -->
                <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,18">
                    <ItemsControl ItemsSource="{Binding ChatMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <!-- User Bubble -->
                                    <Border Style="{StaticResource UserBubble}" Visibility="{Binding IsUser, Converter={StaticResource BoolToVisConverter}}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,5">
                                                <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=YouLabel}" FontSize="9.5" FontWeight="Bold" Foreground="#FEF3C7"/>
                                                <TextBlock Text="{Binding FormattedTime}" DockPanel.Dock="Right" FontSize="9.5" Foreground="#FEF3C7"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Content}" FontSize="13" Foreground="White" TextWrapping="Wrap" LineHeight="20"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Assistant Bubble -->
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource AssistantBubble}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="26" Height="26" CornerRadius="8" Margin="0,0,9,0" Background="{StaticResource AiPrimaryGradient}">
                                                        <Path Data="M12,2 L14.6,8.8 L21.5,11.5 L14.6,14.2 L12,21 L9.4,14.2 L2.5,11.5 L9.4,8.8 Z"
                                                              Fill="White" Width="14" Height="14" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="DocuMind" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource InkPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=AiAssistantLabel}" FontSize="8.5" FontWeight="Bold" Foreground="#9A4A18"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Text="{Binding FormattedTime}" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="9.5" Foreground="{StaticResource InkMutedBrush}"/>
                                            </DockPanel>

                                            <controls:MarkdownView Markdown="{Binding Content}"/>

                                            <Border Background="#F7F1E4" BorderBrush="#E3D7C3" BorderThickness="1" CornerRadius="10" Padding="11" Margin="0,12,0,0"
                                                    Visibility="{Binding HasSources, Converter={StaticResource BoolToVisConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=SourcesHeader}" Style="{StaticResource HudLabel}" Margin="0,0,0,6"/>
                                                    <ItemsControl ItemsSource="{Binding Sources}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#FFFDF9" BorderBrush="#E5DAC7" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,3">
                                                                    <StackPanel>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="10.5" FontWeight="SemiBold" Foreground="#9A3412" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding PageNumber, StringFormat=Page {0}}" FontSize="10" Foreground="{StaticResource InkMutedBrush}"/>
                                                                        </Grid>
                                                                        <TextBlock Text="{Binding Content}" FontSize="10.5" Foreground="{StaticResource InkMutedBrush}" TextWrapping="Wrap" MaxHeight="34" Margin="0,3,0,6"/>
                                                                        <Button Content="{Binding Source={x:Static loc:UiText.Current}, Path=OpenSourceButton}"
                                                                                Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"
                                                                                Style="{StaticResource SecondaryButton}"
                                                                                HorizontalAlignment="Left" Height="28" Padding="12,0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Telemetry / Status Strip (always below ChatScrollViewer) -->
                <Border Grid.Row="1" Background="#FFF6E5" BorderBrush="#E5C996" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="24,0,24,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BusyStatus}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar IsIndeterminate="True" Width="28" Height="6" Foreground="#B45309" Background="#EFE0C6" BorderThickness="0" Margin="0,0,12,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"/>
                        <TextBlock Grid.Column="1" Text="{Binding BusyStatus}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="#78350F"/>
                        <Button Grid.Column="2" Content="{Binding Source={x:Static loc:UiText.Current}, Path=CancelButton}" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Height="28" Margin="10,0,0,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Command Prompt Composer -->
            <Border Grid.Row="2" Background="#FFFDF8" BorderBrush="#E5DAC6" BorderThickness="0,1,0,0" Padding="24,14,24,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Source={x:Static loc:UiText.Current}, Path=QuickStartHeader}" Style="{StaticResource HudLabel}" VerticalAlignment="Top" Margin="0,8,12,0"/>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding PromptTemplates}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Title}"
                                            ToolTip="{Binding Description}"
                                            Command="{Binding DataContext.ApplyTemplateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ChipButton}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <Border Background="#FAF6EE" BorderBrush="#DECBAE" BorderThickness="1" CornerRadius="14" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtInput"
                                     Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding Source={x:Static loc:UiText.Current}, Path=InputTooltip}"
                                     FontSize="13"
                                     Foreground="{StaticResource InkPrimaryBrush}"
                                     CaretBrush="#9A3412"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="10,8"
                                     AcceptsReturn="True"
                                     MaxHeight="92" MinHeight="40"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     PreviewKeyDown="TxtInput_KeyDown"/>
                            <Button Grid.Column="1" Content="{Binding Source={x:Static loc:UiText.Current}, Path=SendButton}" Command="{Binding SendMessageCommand}" Style="{StaticResource PrimaryButton}" MinWidth="98" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=ComposerHint}" FontSize="10.5" Foreground="#7B6A56" Margin="4,7,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
