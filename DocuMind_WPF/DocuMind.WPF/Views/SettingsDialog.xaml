<Window x:Class="DocuMind.WPF.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DocuMind — AI Providers" Height="710" Width="590" MinHeight="560" MinWidth="510"
        WindowStartupLocation="CenterOwner" Background="#F6FAFF" FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#12304A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#6C879E"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3478F6"/>
        <Style x:Key="LabelStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#375873"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="11,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Background" Value="#FBFDFF"/><Setter Property="BorderBrush" Value="#C9DDEE"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#5B9CFF"/><Setter TargetName="Box" Property="Background" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/><Setter Property="Padding" Value="16,0"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#1D5ED8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="12,0"/><Setter Property="Foreground" Value="#28516F"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CFE1F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#EFF7FF"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#9EC6F1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.48"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="26,24,26,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="AI PROVIDERS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="Connect your models" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,5,0,0"/>
                    <TextBlock Text="Credentials are encrypted with Windows DPAPI for your account." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Width="40" Height="40" Background="#DCEEFF" CornerRadius="12"><TextBlock Text="✦" Foreground="#3478F6" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            </DockPanel>
            <Border Background="#ECF6FF" BorderBrush="#CDE4F8" BorderThickness="1" CornerRadius="10" Padding="11" Margin="0,16,0,0">
                <DockPanel><StackPanel><TextBlock Text="OPENROUTER QUICK SETUP" FontSize="9" FontWeight="Bold" Foreground="#3478C9"/><TextBlock Text="Prefill the endpoint and recommended chat + embedding models." FontSize="11" Foreground="#52758F" Margin="0,3,0,0"/></StackPanel><Button Content="Use OpenRouter" Command="{Binding UseOpenRouterCommand}" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" Margin="14,0,0,0"/></DockPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">
                <TextBlock Text="Provider" Style="{StaticResource LabelStyle}"/>
                <ComboBox ItemsSource="{Binding AvailableProviders}" SelectedItem="{Binding SelectedProvider}" IsEnabled="{Binding IsEditable}"
                          Height="38" Padding="10,0" FontSize="12" Foreground="{StaticResource InkBrush}" Background="White" BorderBrush="#C9DDEE"/>

                <TextBlock Text="API key" Style="{StaticResource LabelStyle}" Margin="0,18,0,6"/>
                <PasswordBox x:Name="KeyBox" PasswordChanged="KeyBox_PasswordChanged" Height="38" Padding="10" IsEnabled="{Binding IsEditable}" Background="#FBFDFF" BorderBrush="#C9DDEE"/>
                <DockPanel Margin="0,7,0,0"><TextBlock Text="Stored only on this device, encrypted for the current Windows user." FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><Button Content="Hold to reveal" PreviewMouseLeftButtonDown="RevealKey_Down" PreviewMouseLeftButtonUp="RevealKey_Up" MouseLeave="RevealKey_Leave" Style="{StaticResource SecondaryButton}" Height="27" Padding="9,0" DockPanel.Dock="Right" Margin="12,0,0,0"/></DockPanel>
                <TextBlock x:Name="RevealedKey" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#24619A" Background="#ECF6FF" Margin="0,7,0,0" Padding="8"/>

                <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Chat model" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding ChatModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" IsEnabled="{Binding IsEditable}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Temperature" Style="{StaticResource LabelStyle}"/><DockPanel><TextBlock Text="{Binding Temperature, StringFormat={}{0:F2}}" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" Foreground="#3478F6"/><Slider Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Temperature}" IsEnabled="{Binding IsEditable}" Margin="0,3,8,0"/></DockPanel></StackPanel>
                </Grid>

                <TextBlock Text="Embedding model" Style="{StaticResource LabelStyle}" Margin="0,18,0,6"/>
                <TextBox Text="{Binding EmbeddingModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" IsEnabled="{Binding IsEditable}"/>
                <CheckBox Content="Use this provider for document embeddings and RAG" IsChecked="{Binding UseForEmbedding}" IsEnabled="{Binding IsEditable}" FontSize="11" FontWeight="SemiBold" Foreground="#315A78" Margin="0,10,0,0"/>
                <DockPanel Margin="0,7,0,0"><TextBlock Text="Changing the embedding profile requires re-indexing your documents." FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Test embedding" Command="{Binding TestEmbeddingCommand}" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding IsEditable}" Margin="12,0,0,0"/><Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"/></StackPanel></DockPanel>

                <TextBlock Text="Base URL" Style="{StaticResource LabelStyle}" Margin="0,18,0,6"/>
                <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" IsEnabled="{Binding IsEditable}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F0F8FF" BorderBrush="#CEE5F8" BorderThickness="1" CornerRadius="9" Padding="11,9" Margin="0,16,0,14">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#28648F" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Test connection" Command="{Binding TestConnectionCommand}" Style="{StaticResource SecondaryButton}" Height="40" IsEnabled="{Binding IsEditable}"/>
            <Button Grid.Column="2" Content="Save provider" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsEditable}"/>
        </Grid>
    </Grid>
</Window>
