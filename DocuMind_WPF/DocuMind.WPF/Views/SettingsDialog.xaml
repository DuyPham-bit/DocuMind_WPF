<Window x:Class="DocuMind.WPF.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DocuMind.WPF.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DocuMind — AI Providers" Height="740" Width="640" MinHeight="560" MinWidth="540"
        WindowStartupLocation="CenterOwner"
        Background="#FAF6EE"
        Foreground="#1F1A14"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DocuMind.WPF;component/Styles/FuturisticTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="AI PROVIDERS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentTextBrush}"/>
                    <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=SettingsTitle}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource InkPrimaryBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=SettingsSubtitle}" FontSize="12" Foreground="{StaticResource InkMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Width="42" Height="42" CornerRadius="12" Background="{StaticResource AiPrimaryGradient}" VerticalAlignment="Top">
                    <Path Data="M12,2 L14.6,8.8 L21.5,11.5 L14.6,14.2 L12,21 L9.4,14.2 L2.5,11.5 L9.4,8.8 Z"
                          Fill="White" Width="20" Height="20" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <Border Background="#F6ECDC" BorderBrush="#DECBAE" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=OpenRouterQuickTitle}" FontSize="9.5" FontWeight="Bold" Foreground="#9A3412"/>
                        <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=OpenRouterQuickDesc}" FontSize="11" Foreground="{StaticResource InkMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding Source={x:Static loc:UiText.Current}, Path=UseOpenRouterButton}" Command="{Binding UseOpenRouterCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=ProviderLabel}" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding AvailableProviders}"
                          SelectedItem="{Binding SelectedProvider}"
                          IsEnabled="{Binding IsEditable}"
                          Style="{StaticResource FuturisticComboBox}"/>

                <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=ApiKeyLabel}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                <PasswordBox x:Name="KeyBox"
                             PasswordChanged="KeyBox_PasswordChanged"
                             IsEnabled="{Binding IsEditable}"
                             Style="{StaticResource WarmPasswordBoxStyle}"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Source={x:Static loc:UiText.Current}, Path=ApiKeyHint}" FontSize="10.5" Foreground="{StaticResource InkMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Grid.Column="1" Content="{Binding Source={x:Static loc:UiText.Current}, Path=HoldToRevealButton}"
                            PreviewMouseLeftButtonDown="RevealKey_Down"
                            PreviewMouseLeftButtonUp="RevealKey_Up"
                            MouseLeave="RevealKey_Leave"
                            Style="{StaticResource SecondaryButton}"
                            Height="30"/>
                </Grid>
                <TextBlock x:Name="RevealedKey" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#7C2D12" Background="#F6ECDC" Margin="0,7,0,0" Padding="8"/>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=ChatModelLabel}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ChatModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" IsEnabled="{Binding IsEditable}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=TemperatureLabel}" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Temperature}" IsEnabled="{Binding IsEditable}" Margin="0,6,10,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Temperature, StringFormat={}{0:F2}}" FontSize="12" FontWeight="Bold" Foreground="#9A3412" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=EmbeddingModelLabel}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                <TextBox Text="{Binding EmbeddingModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" IsEnabled="{Binding IsEditable}"/>
                <CheckBox Content="{Binding Source={x:Static loc:UiText.Current}, Path=UseForEmbeddingLabel}"
                          IsChecked="{Binding UseForEmbedding}"
                          IsEnabled="{Binding IsEditable}"
                          FontSize="11.5" FontWeight="SemiBold"
                          Foreground="{StaticResource InkPrimaryBrush}"
                          Margin="0,11,0,0"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Source={x:Static loc:UiText.Current}, Path=ReindexHint}" FontSize="10.5" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="{Binding Source={x:Static loc:UiText.Current}, Path=TestEmbeddingButton}" Command="{Binding TestEmbeddingCommand}" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding IsEditable}" Margin="0,0,8,0"/>
                        <Button Content="{Binding Source={x:Static loc:UiText.Current}, Path=CancelButton}" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=BaseUrlLabel}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" IsEnabled="{Binding IsEditable}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#FFF6E5" BorderBrush="#E5C996" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,14,0,14">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="#78350F" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{Binding Source={x:Static loc:UiText.Current}, Path=TestConnectionButton}" Command="{Binding TestConnectionCommand}" Style="{StaticResource SecondaryButton}" Height="40" IsEnabled="{Binding IsEditable}"/>
            <Button Grid.Column="2" Content="{Binding Source={x:Static loc:UiText.Current}, Path=SaveProviderButton}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsEditable}"/>
        </Grid>
    </Grid>
</Window>
