<Window x:Class="DocuMind.WPF.Views.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DocuMind.WPF.Views"
        xmlns:loc="clr-namespace:DocuMind.WPF.Localization"
        Title="{Binding Source={x:Static loc:UiText.Current}, Path=QuizWindowTitle}"
        Height="800" Width="960" MinHeight="620" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="#FAF6EE"
        Foreground="#1F1A14"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DocuMind.WPF;component/Styles/FuturisticTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="256"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=QuizEyebrow}" Style="{StaticResource HudLabel}"/>
                <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=QuizHeading}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkPrimaryBrush}" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding HeaderSubtitle}" FontSize="12" Foreground="{StaticResource InkMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="12" Background="{StaticResource AiPrimaryGradient}" VerticalAlignment="Top">
                <Path Data="M12,2 L14.6,8.8 L21.5,11.5 L14.6,14.2 L12,21 L9.4,14.2 L2.5,11.5 L9.4,8.8 Z"
                      Fill="White" Width="19" Height="19" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- Controls -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource GlassCard}" Padding="14,10" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=QuizCountLabel}" VerticalAlignment="Center" Margin="14,0,8,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkSecondaryBrush}"/>
                    <ComboBox x:Name="CountBox" ItemsSource="{Binding QuestionCounts}" SelectedItem="{Binding QuestionCount}" IsEnabled="{Binding IsSelectionEditable}" Style="{StaticResource FuturisticComboBox}" Width="76" Height="36" Margin="0,0,10,0"/>
                    <Button Content="{Binding Source={x:Static loc:UiText.Current}, Path=QuizGenerateButton}" Command="{Binding GenerateCommand}" Style="{StaticResource PrimaryButton}" Height="36" Padding="16,0"/>
                </StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=QuizTopicLabel}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkSecondaryBrush}" DockPanel.Dock="Left"/>
                <TextBox x:Name="TopicBox" Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" MinHeight="36" Height="36" Padding="10,6"
                         IsEnabled="{Binding IsSelectionEditable}"
                         ToolTip="{Binding Source={x:Static loc:UiText.Current}, Path=QuizTopicTooltip}"/>
            </DockPanel>
        </Border>

        <!-- Source documents -->
        <Border x:Name="DocumentPicker" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource GlassCard}"
                Padding="14,10" Margin="0,0,0,10" IsEnabled="{Binding IsSelectionEditable}">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{Binding Source={x:Static loc:UiText.Current}, Path=QuizSelectAllButton}" Command="{Binding SelectAllDocumentsCommand}" Style="{StaticResource SecondaryButton}" Height="28" Padding="12,0" FontSize="11" Margin="0,0,8,0"/>
                        <Button Content="{Binding Source={x:Static loc:UiText.Current}, Path=QuizClearSelectionButton}" Command="{Binding ClearDocumentSelectionCommand}" Style="{StaticResource SecondaryButton}" Height="28" Padding="12,0" FontSize="11"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=QuizDocumentsHeader}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource InkPrimaryBrush}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="{Binding DocumentSelectionSummary}" Foreground="{StaticResource InkMutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <ScrollViewer MaxHeight="78" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="DocumentList" ItemsSource="{Binding Documents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAF5EB" BorderBrush="#E6DAC5" BorderThickness="1" CornerRadius="9" Padding="10,6" Margin="0,2">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" FontSize="10.5" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding StatusLabel}"/>
                                                    <Setter Property="Foreground" Value="#047857"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                            <Setter Property="Foreground" Value="#B45309"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <CheckBox Style="{StaticResource WarmCheckBox}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsAvailable}" ToolTip="{Binding SourcePath}">
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkPrimaryBrush}"/>
                                        </CheckBox>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Questions + Empty State -->
        <Grid Grid.Row="3" Grid.Column="0">
            <Border MaxWidth="420" Padding="26,22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Questions.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12" HorizontalAlignment="Center" Margin="0,0,0,12" Background="{StaticResource AiPrimaryGradient}">
                        <Path Data="M12,2 L14.6,8.8 L21.5,11.5 L14.6,14.2 L12,21 L9.4,14.2 L2.5,11.5 L9.4,8.8 Z"
                              Fill="White" Width="20" Height="20" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=QuizEmptyTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource InkPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=QuizEmptySubtitle}" FontSize="12" Foreground="{StaticResource InkMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="QuestionScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="QuestionList" ItemsSource="{Binding Questions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCard}" Padding="16,14" Margin="0,0,4,10">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding ResultText}" DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" Margin="10,0,0,0"/>
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource InkPrimaryBrush}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Options}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="optBorder" Background="#FAF5EB" CornerRadius="9" Padding="10,7" Margin="0,3" BorderThickness="1" BorderBrush="#E6DAC5">
                                                    <RadioButton Content="{Binding Label}" Style="{StaticResource WarmRadioButton}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                 GroupName="{Binding DataContext.GroupName, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                 IsEnabled="{Binding DataContext.IsRevealed, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={x:Static local:InverseBoolConverter.Instance}}"/>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsCorrectAnswer}" Value="True">
                                                        <Setter TargetName="optBorder" Property="Background" Value="#DCFCE7"/>
                                                        <Setter TargetName="optBorder" Property="BorderBrush" Value="#22C55E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsWrongChoice}" Value="True">
                                                        <Setter TargetName="optBorder" Property="Background" Value="#FEE2E2"/>
                                                        <Setter TargetName="optBorder" Property="BorderBrush" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Background="#F7F1E4" BorderBrush="#E3D7C3" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,10,0,0"
                                            Visibility="{Binding IsRevealed, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="{StaticResource InkSecondaryBrush}" FontSize="12"/>
                                            <TextBlock Text="{Binding SourceLabel}" ToolTip="{Binding Question.Source.Content}" Foreground="{StaticResource AccentTextBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- History -->
        <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource GlassCard}" Padding="14,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Source={x:Static loc:UiText.Current}, Path=QuizHistoryHeader}" Style="{StaticResource HudLabel}" Margin="0,0,0,8"/>
                <Grid>
                    <TextBlock Text="{Binding Source={x:Static loc:UiText.Current}, Path=QuizNoHistoryText}"
                               FontSize="11.5" Foreground="{StaticResource InkMutedBrush}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding History.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ListBox x:Name="HistoryList" ItemsSource="{Binding History}" DisplayMemberPath="Label"
                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource InkPrimaryBrush}" FontSize="11.5"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Padding" Value="9,7"/>
                            <Setter Property="Background" Value="#FAF5EB"/>
                            <Setter Property="BorderBrush" Value="#E6DAC5"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="9"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter>
                                                <ContentPresenter.Resources>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                    </Style>
                                                </ContentPresenter.Resources>
                                            </ContentPresenter>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#F3EBDC"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#D9CBB3"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#EFE0C6"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#B45309"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button Content="{Binding Source={x:Static loc:UiText.Current}, Path=CancelButton}" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Height="36" Padding="14,0" Margin="0,0,8,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                <Button Content="{Binding Source={x:Static loc:UiText.Current}, Path=QuizRetryButton}" Command="{Binding RetryCommand}" Style="{StaticResource SecondaryButton}" Height="36" Padding="14,0" Margin="0,0,8,0"/>
                <Button Content="{Binding Source={x:Static loc:UiText.Current}, Path=QuizSubmitButton}" Command="{Binding SubmitCommand}" Style="{StaticResource PrimaryButton}" Height="36" MinWidth="92"/>
            </StackPanel>
            <Border Background="#FFF6E5" BorderBrush="#E5C996" BorderThickness="1" CornerRadius="10" Padding="12,8" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar IsIndeterminate="True" Width="24" Height="5" Foreground="#B45309" Background="#EFE0C6" BorderThickness="0" Margin="0,0,10,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ScoreText}" FontSize="14" FontWeight="Bold" Foreground="#047857">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#78350F" FontSize="11.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</Window>
