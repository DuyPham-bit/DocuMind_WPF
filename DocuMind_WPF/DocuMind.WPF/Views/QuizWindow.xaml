<Window x:Class="DocuMind.WPF.Views.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DocuMind.WPF.Views"
        Title="DocuMind – Quiz ôn tập"
        Height="720" Width="960" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Tahoma, sans-serif">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1D4ED8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Background" Value="#94A3B8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
            <TextBlock Text="📝 Quiz ôn tập từ tài liệu" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="{Binding WorkspaceName, StringFormat='Workspace: {0} · câu hỏi sinh từ tài liệu đã nạp, app tự chấm điểm'}" FontSize="12" Foreground="#64748B"/>
        </StackPanel>

        <!-- Controls -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Số câu:" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#475569"/>
                    <ComboBox x:Name="CountBox" ItemsSource="{Binding QuestionCounts}" SelectedItem="{Binding QuestionCount}" Width="60" Height="30" Margin="0,0,10,0"/>
                    <Button Content="✨ Tạo quiz" Command="{Binding GenerateCommand}" Style="{StaticResource PrimaryBtn}"/>
                </StackPanel>
                <TextBlock Text="Chủ đề:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#475569" DockPanel.Dock="Left"/>
                <TextBox x:Name="TopicBox" Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center"
                         ToolTip="Ví dụ: Dependency Injection, vòng đời DbContext... Để trống để ôn toàn bộ tài liệu"/>
            </DockPanel>
        </Border>

        <!-- Questions -->
        <ScrollViewer Grid.Row="2" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="QuestionList" ItemsSource="{Binding Questions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,10">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding ResultText}" DockPanel.Dock="Right" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Options}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="optBorder" CornerRadius="6" Padding="8,5" Margin="0,2" BorderThickness="1" BorderBrush="Transparent">
                                                <RadioButton Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                             GroupName="{Binding DataContext.GroupName, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                             IsEnabled="{Binding DataContext.IsRevealed, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={x:Static local:InverseBoolConverter.Instance}}"
                                                             FontSize="13" Foreground="#1E293B"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsCorrectAnswer}" Value="True">
                                                    <Setter TargetName="optBorder" Property="Background" Value="#DCFCE7"/>
                                                    <Setter TargetName="optBorder" Property="BorderBrush" Value="#22C55E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsWrongChoice}" Value="True">
                                                    <Setter TargetName="optBorder" Property="Background" Value="#FEE2E2"/>
                                                    <Setter TargetName="optBorder" Property="BorderBrush" Value="#EF4444"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Visibility="{Binding IsRevealed, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="#334155" FontSize="12"/>
                                    <TextBlock Text="{Binding SourceLabel}" ToolTip="{Binding Question.Source.Content}" Foreground="#1D4ED8" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- History -->
        <Border Grid.Row="2" Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="LỊCH SỬ ÔN TẬP" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                <ListBox x:Name="HistoryList" ItemsSource="{Binding History}" DisplayMemberPath="Label" BorderThickness="0" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Hủy" Command="{Binding CancelCommand}" Height="34" Padding="12,0" Margin="0,0,8,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                <Button Content="↺ Làm lại" Command="{Binding RetryCommand}" Height="34" Padding="12,0" Margin="0,0,8,0"/>
                <Button Content="Nộp bài" Command="{Binding SubmitCommand}" Style="{StaticResource PrimaryBtn}"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ScoreText}" FontSize="16" FontWeight="Bold" Foreground="#16A34A"/>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#1E40AF" FontSize="12"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
